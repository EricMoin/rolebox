{
  "name": "rolebox",
  "version": "2.0.0",
  "description": "Agent plugin for major harnesses — DeepSeek Harness (DSH), OpenCode, Pi and Codex: define custom AI agent roles with per-role prompts, models, skills, permissions, memory and multi-agent orchestration.",
  "engines": {
    "opencode": "^1.0.0",
    "dsh": ">=0.2.1-alpha.3",
    "node": ">=26.4.0"
  },
  "type": "module",
  "bin": {
    "rolebox": "dist/cli/main.js"
  },
  "main": "dist/entries/opencode.js",
  "types": "dist/entries/opencode.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entries/opencode.d.ts",
      "import": "./dist/entries/opencode.js",
      "default": "./dist/entries/opencode.js"
    },
    "./server": {
      "types": "./dist/entries/opencode2.d.ts",
      "import": "./dist/entries/opencode2.js",
      "default": "./dist/entries/opencode2.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./pi": {
      "types": "./dist/entries/pi.d.ts",
      "import": "./dist/entries/pi.js"
    },
    "./dsh": {
      "types": "./dist/entries/dsh.d.ts",
      "import": "./dist/entries/dsh.js"
    },
    "./codex": {
      "types": "./dist/entries/codex.d.ts",
      "import": "./dist/entries/codex.js"
    },
    "./dsh/cordis.patch.yml": "./dsh/cordis.patch.yml",
    "./dsh/package.json": "./package.json",
    "./client": {
      "types": "./dist/dsh-web-client.d.ts",
      "default": "./dist/dsh-web-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dsh",
    "examples",
    "functions"
  ],
  "scripts": {
    "build": "node --import tsx scripts/build-all.ts",
    "build:clean": "node --import tsx scripts/clean-dist.ts",
    "build:bin-executable": "node --import tsx scripts/mark-bin-executable.ts",
    "build:entry-aliases": "node --import tsx scripts/build-entry-aliases.ts",
    "build:tui": "node --import tsx scripts/build-tui.ts",
    "build:dsh-web-client": "node --import tsx scripts/build-dsh-web-client.ts",
    "prepack": "node --import tsx scripts/npm-readme.ts absolute",
    "postpack": "node --import tsx scripts/npm-readme.ts relative",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.tui-tests.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "node --experimental-ffi --import tsx scripts/test.ts",
    "test:core": "npm test -- --exclude=tests/tui/**",
    "test:tui": "npm test -- tests/tui/",
    "test:browse:e2e": "node --import tsx scripts/test-browse-e2e.ts",
    "test:hosts:e2e": "node --import tsx scripts/test-hosts-e2e.ts",
    "check:hosts": "node --import tsx scripts/host-versions.ts check",
    "update:hosts": "node --import tsx scripts/host-versions.ts update",
    "postinstall": "node -e \"try{require('./dist/cli/postinstall.js')}catch(e){}\"",
    "test:package": "node --import tsx scripts/test-package.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pi-extension",
    "pi-package",
    "dsh",
    "codex",
    "deepseek",
    "ai-agent",
    "llm",
    "agent-framework",
    "multi-agent",
    "agent-orchestration",
    "subagents",
    "role",
    "yaml",
    "skills",
    "memory",
    "lsp",
    "workflow",
    "cli",
    "tui",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-bundle",
    "cordis",
    "cordis-plugin",
    "deepseek-harness-plugin"
  ],
  "pi": {
    "extensions": [
      "./dist/entries/pi.js"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EricMoin/rolebox.git"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@fontsource/space-grotesk": "^5.2.10",
    "cheerio": "^1.2.0",
    "citty": "^0.2.2",
    "fast-glob": "^3.3.0",
    "js-yaml": "^4.1.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "4.1.8"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@earendil-works/pi-coding-agent": ">=0.86.0",
    "@mozilla/readability": ">=0.5.0",
    "@opencode-ai/plugin": "^1.3.0",
    "@opencode/plugin": "^2.0.18",
    "@opentui/core": ">=0.6.8",
    "@opentui/solid": ">=0.6.8",
    "crawlee": ">=3.0.0",
    "linkedom": ">=0.18.0",
    "playwright": ">=1.40.0",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "crawlee": {
      "optional": true
    },
    "@mozilla/readability": {
      "optional": true
    },
    "linkedom": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs-observation-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.3",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@opencode-ai/plugin": "1.19.4",
    "@opencode/plugin": "2.1.4",
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@resvg/resvg-js": "^2.6.2",
    "@types/babel__core": "^7.20.5",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.7.1",
    "@types/turndown": "^5.0.6",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-preset-solid": "1.9.12",
    "esbuild": "0.28.2",
    "playwright": "1.61.1",
    "semver": "^7.7.3",
    "solid-js": "1.9.12",
    "tsx": "4.23.15",
    "typescript": "^5.7.0",
    "vitest": "4.1.6",
    "yaml": "^2.9.0"
  },
  "packageManager": "npm@11.17.0"
}
