{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": ["src/tui/**/*.ts", "src/tui/**/*.tsx", "src/tui/**/*.d.ts", "src/utils/**/*.ts"],
  "exclude": []
}
